FROM ssrecomp-tsp-poc:latest
RUN apt-get -o Acquire::Check-Valid-Until=false update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Check-Valid-Until=false install -y -qq python3 python3-pip clang lld git >/dev/null && \
    rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir -q cmake==3.27.9 && cmake --version | head -1
RUN clang --version | head -1 && ld.lld --version | head -1 && python3 --version
